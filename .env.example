# ────────────────────────────────────────────────────────────────
# E-Fulfill Hub — Environment Configuration
# Copy this file to `.env` and adjust credentials if needed.
# ────────────────────────────────────────────────────────────────

# ── Database (MySQL 8) ─────────────────────────────────────────
# Prisma uses this URL. Create the database first in MySQL:
#   CREATE DATABASE efulfillhub CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root@localhost:3306/efulfillhub"

# ── Authentication ──────────────────────────────────────────────
# Secret 32+ byte string for signing httpOnly session JWT.
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="7d"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# ── Encryption Key for Integration Credentials (At Rest) ───────
# AES-256-GCM: wajib tepat 64 karakter hex (32 byte). Buat sendiri untuk tiap instalasi.
ENCRYPTION_KEY=""

# ── Shopee Open Platform v2 ─────────────────────────────────────
# Kredensial resmi Shopee Open Platform v2.
# Pastikan server Anda berjalan di port 3000 (http://localhost:3000)
# agar Redirect URL cocok dengan whitelist di Shopee Console.
# Isi Partner ID & Partner Key lewat menu "Hubungkan Shopee" di aplikasi, JANGAN menulis di sini.
# Nilai di bawah hanya placeholder supaya berkas ini aman dipublikasikan.
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_REDIRECT_URL="http://localhost:3000/api/v1/integrations/shopee/callback"
SHOPEE_API_HOST="https://partner.shopeemobile.com"

# Set "true" untuk Shopee Sandbox (lingkungan pengujian).
SHOPEE_SANDBOX="true"
SHOPEE_SANDBOX_HOST="https://openplatform.sandbox.test-stable.shopee.sg"
